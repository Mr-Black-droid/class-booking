# Copy this file to .env and fill it in. .env is never committed (see .gitignore).
# On GitHub, the same names are set as repository Variables/Secrets instead (README step 7).

# ---- Public settings: these end up in the web page. They are safe to publish by design;
# ---- the database rules decide who can see or change anything.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
APP_TITLE=Class slot booking
# Optional: only accept Google accounts from this domain on the sign-in screen, e.g. school.example
GOOGLE_HOSTED_DOMAIN=

# ---- Who is allowed in. Used only by `node scripts/make-seed.mjs`, which writes SQL for you
# ---- to paste into Supabase. These never go into the web page.
ADMIN_EMAIL_BOSS=boss@example.com
ADMIN_EMAIL_DEVELOPER=developer@example.com
ADMIN_EMAIL_HOD=hod@example.com
# Comma separated, optional. Staff can also be added later from the People tab.
STAFF_EMAILS=
# Public address of the page (used in email links) and the school's time zone.
SITE_URL=https://YOUR-ACCOUNT.github.io/class-booking/
TIMEZONE=Europe/Warsaw
# true = admins get an email for every booking, not only for clashes.
NOTIFY_EVERY_BOOKING=false

# ---- Server secrets: set these in Supabase (Edge Functions > Secrets), never on GitHub Pages.
RESEND_API_KEY=
NOTIFY_FROM=Class booking <bookings@your-verified-domain.example>
WEBHOOK_SECRET=pick-a-long-random-string
